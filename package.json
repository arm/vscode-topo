{
    "name": "topo",
    "displayName": "Topo",
    "icon": "media/topo.png",
    "publisher": "Arm",
    "description": "Compose, configure, and deploy containerized examples for Arm hardware",
    "license": "Apache-2.0",
    "version": "0.21.0",
    "engines": {
        "vscode": "^1.109.0",
        "node": "22",
        "npm": "10"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onUri"
    ],
    "main": "./dist/extension.js",
    "topo": {
        "version": "14.0.0-pre.0",
        "sha256": {
            "win32-x64": "73cb6af7181707540b8774cb64c4dc7d5c1c0a412ee6c653c1fcaa3403ba3522",
            "win32-arm64": "70b77a5904e80c25c42608fd88683e76b6d52290412c2fd5157fc2c6075b3412",
            "linux-x64": "e51819a9b1ec3fe5a096eccd85d34d49c80e32adfb18bb924348cdbf57c65e3f",
            "linux-arm64": "3546d1c7623e83292ef91e5149acfd68410d8daad5dc822f8b41ab39b8005112",
            "darwin-x64": "743794d90e07024c073b860b6a796702a49a4cc4cebcfef31900ec3b931c9376",
            "darwin-arm64": "757813d72e57f49182fe375019bfa5d48a9982457d0d05d8b99ec9c5ad875b66"
        }
    },
    "contributes": {
        "chatSkills": [
            {
                "path": "./skills/topo-cli-location/SKILL.md"
            }
        ],
        "taskDefinitions": [
            {
                "type": "topo",
                "when": "shellExecutionSupported",
                "required": [
                    "command",
                    "args"
                ],
                "properties": {
                    "command": {
                        "type": "string",
                        "enum": [
                            "clone",
                            "configure",
                            "deploy",
                            "health",
                            "install",
                            "projects",
                            "ps",
                            "setup-keys",
                            "stop"
                        ],
                        "description": "Supported Topo command to run."
                    },
                    "args": {
                        "type": "array",
                        "description": "Arguments passed to the Topo command in order.",
                        "items": {
                            "type": "string"
                        }
                    },
                    "options": {
                        "type": "object",
                        "description": "Execution options for the Topo command.",
                        "additionalProperties": false,
                        "properties": {
                            "cwd": {
                                "type": "string",
                                "description": "Working directory for the Topo command. Omit to use the task's workspace folder."
                            },
                            "env": {
                                "type": "object",
                                "description": "Environment variables added to the Topo command's environment.",
                                "additionalProperties": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "topo.cloneProject",
                "title": "Clone Project",
                "icon": "$(repo-clone)",
                "category": "Topo"
            },
            {
                "command": "topo.remoteClone",
                "title": "Clone Remote Project",
                "category": "Topo"
            },
            {
                "command": "topo.localClone",
                "title": "Clone Local Project",
                "category": "Topo"
            },
            {
                "command": "topo.installSkill",
                "title": "Install Skill",
                "icon": "$(file-add)",
                "category": "Topo"
            },
            {
                "command": "topo.uninstallSkill",
                "title": "Uninstall Skill",
                "icon": "$(trash)",
                "category": "Topo"
            },
            {
                "command": "topo.openContainerShell",
                "title": "Open Container Shell",
                "icon": "$(terminal)",
                "category": "Topo"
            },
            {
                "command": "topo.connectViaSSH",
                "title": "Connect via SSH",
                "icon": "$(terminal)",
                "category": "Topo"
            },
            {
                "command": "topo.openContainerInBrowser",
                "title": "Open in Browser",
                "icon": "$(globe)",
                "category": "Topo"
            },
            {
                "command": "topo.startContainer",
                "title": "Start",
                "icon": "$(play)",
                "category": "Topo"
            },
            {
                "command": "topo.stopContainer",
                "title": "Stop",
                "icon": "$(stop)",
                "category": "Topo"
            },
            {
                "command": "topo.deleteContainer",
                "title": "Delete",
                "icon": "$(trash)",
                "category": "Topo"
            },
            {
                "command": "topo.selectTarget",
                "title": "Select Target",
                "icon": "$(target)",
                "category": "Topo"
            },
            {
                "command": "topo.resetExtensionData",
                "title": "Reset Data",
                "icon": "$(discard)",
                "category": "Topo"
            },
            {
                "command": "topo.clearTargetSelection",
                "title": "Clear Selection",
                "icon": "$(circle-slash)",
                "category": "Topo"
            },
            {
                "command": "topo.openSettings",
                "title": "Open Settings",
                "icon": "$(gear)",
                "category": "Topo"
            },
            {
                "command": "topo.fixIssue",
                "title": "Fix",
                "icon": "$(wrench)",
                "category": "Topo"
            },
            {
                "command": "topo.fixTargetIssues",
                "title": "Fix Issues",
                "icon": "$(wrench)",
                "category": "Topo"
            },
            {
                "command": "topo.refreshHost",
                "title": "Refresh",
                "icon": "$(refresh)",
                "category": "Topo"
            },
            {
                "command": "topo.refreshProjects",
                "title": "Refresh",
                "icon": "$(refresh)",
                "category": "Topo"
            },
            {
                "command": "topo.refreshTargetData",
                "title": "Refresh",
                "icon": "$(refresh)",
                "category": "Topo"
            },
            {
                "command": "topo.showOutput",
                "title": "Open Topo Output",
                "icon": "$(output)",
                "category": "Topo"
            },
            {
                "command": "topo.deploy",
                "title": "Deploy",
                "category": "Topo"
            },
            {
                "command": "topo.configure.context",
                "title": "Topo Configure",
                "icon": "$(gear)"
            },
            {
                "command": "topo.deploy.context",
                "title": "Topo Deploy",
                "icon": "$(rocket)"
            },
            {
                "command": "topo.stop.context",
                "title": "Topo Stop",
                "icon": "$(stop)"
            },
            {
                "command": "topo.configureProject",
                "title": "Configure",
                "icon": "$(gear)",
                "category": "Topo"
            },
            {
                "command": "topo.deployProject",
                "title": "Deploy",
                "icon": "$(debug-start)",
                "category": "Topo"
            },
            {
                "command": "topo.stopProject",
                "title": "Stop",
                "icon": "$(debug-stop)",
                "category": "Topo"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "topo",
                    "title": "Topo",
                    "icon": "media/topo.svg"
                }
            ]
        },
        "views": {
            "topo": [
                {
                    "id": "topo.host-manager",
                    "name": "Host",
                    "visibility": "visible",
                    "icon": "$(vm-small)"
                },
                {
                    "id": "topo.projects",
                    "name": "Projects",
                    "visibility": "visible",
                    "icon": "$(folder-library)"
                },
                {
                    "id": "topo.target-manager",
                    "name": "Target",
                    "visibility": "visible",
                    "icon": "media/topo.svg"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "topo.target-manager",
                "when": "topo.selectedTargetState == 'unselected'",
                "contents": "No target selected\n[Select a target](command:topo.selectTarget)"
            },
            {
                "view": "topo.projects",
                "when": "topo.projectCount == 0",
                "contents": "No projects found\n[Clone a project](command:topo.cloneProject)"
            }
        ],
        "menus": {
            "editor/title/context": [
                {
                    "command": "topo.configure.context",
                    "group": "topo@1",
                    "when": "resourceFilename =~ /^compose\\.yaml$/"
                },
                {
                    "command": "topo.deploy.context",
                    "group": "topo@2",
                    "when": "resourceFilename =~ /^compose\\.yaml$/"
                },
                {
                    "command": "topo.stop.context",
                    "group": "topo@3",
                    "when": "resourceFilename =~ /^compose\\.yaml$/"
                }
            ],
            "explorer/context": [
                {
                    "command": "topo.configure.context",
                    "group": "topo@1",
                    "when": "resourceFilename =~ /^compose\\.yaml$/"
                },
                {
                    "command": "topo.deploy.context",
                    "group": "topo@2",
                    "when": "resourceFilename =~ /^compose\\.yaml$/"
                },
                {
                    "command": "topo.stop.context",
                    "group": "topo@3",
                    "when": "resourceFilename =~ /^compose\\.yaml$/"
                }
            ],
            "commandPalette": [
                {
                    "command": "topo.cloneProject",
                    "when": "false"
                },
                {
                    "command": "topo.selectTarget",
                    "when": "false"
                },
                {
                    "command": "topo.resetExtensionData",
                    "when": "false"
                },
                {
                    "command": "topo.clearTargetSelection",
                    "when": "false"
                },
                {
                    "command": "topo.fixIssue",
                    "when": "false"
                },
                {
                    "command": "topo.fixTargetIssues",
                    "when": "false"
                },
                {
                    "command": "topo.stopContainer",
                    "when": "false"
                },
                {
                    "command": "topo.startContainer",
                    "when": "false"
                },
                {
                    "command": "topo.deleteContainer",
                    "when": "false"
                },
                {
                    "command": "topo.openContainerShell",
                    "when": "false"
                },
                {
                    "command": "topo.connectViaSSH",
                    "when": "false"
                },
                {
                    "command": "topo.openContainerInBrowser",
                    "when": "false"
                },
                {
                    "command": "topo.configure.context",
                    "when": "false"
                },
                {
                    "command": "topo.deploy.context",
                    "when": "false"
                },
                {
                    "command": "topo.stop.context",
                    "when": "false"
                },
                {
                    "command": "topo.configureProject",
                    "when": "false"
                },
                {
                    "command": "topo.deployProject",
                    "when": "false"
                },
                {
                    "command": "topo.stopProject",
                    "when": "false"
                },
                {
                    "command": "topo.refreshHost",
                    "when": "false"
                },
                {
                    "command": "topo.refreshProjects",
                    "when": "false"
                },
                {
                    "command": "topo.refreshTargetData",
                    "when": "false"
                },
                {
                    "command": "topo.showOutput",
                    "when": "false"
                }
            ],
            "view/item/context": [
                {
                    "command": "topo.installSkill",
                    "when": "view == topo.host-manager && viewItem =~ /TopoSkillInstallAvailable/",
                    "group": "inline@1"
                },
                {
                    "command": "topo.uninstallSkill",
                    "when": "view == topo.host-manager && viewItem =~ /TopoSkillUninstallAvailable/",
                    "group": "inline@2"
                },
                {
                    "command": "topo.showOutput",
                    "when": "viewItem =~ /OpenableError/",
                    "group": "inline@1"
                },
                {
                    "command": "topo.resetExtensionData",
                    "when": "view == topo.target-manager && viewItem =~ /DataIssueError/",
                    "group": "inline"
                },
                {
                    "command": "topo.fixTargetIssues",
                    "when": "view === topo.target-manager && viewItem =~ /Health/ && viewItem =~ /HasFixableIssues/",
                    "group": "inline@1"
                },
                {
                    "command": "topo.fixIssue",
                    "when": "view === topo.target-manager && viewItem =~ /HealthCheck/ && viewItem =~ /Fixable/",
                    "group": "inline@1"
                },
                {
                    "command": "topo.openContainerShell",
                    "when": "view === topo.projects && viewItem =~ /service/ && viewItem =~ /running/ && viewItem =~ /Linux Host/",
                    "group": "inline@1"
                },
                {
                    "command": "topo.openContainerInBrowser",
                    "when": "view === topo.projects && viewItem =~ /service/ && viewItem =~ /running/ && viewItem =~ /browser/",
                    "group": "inline@2"
                },
                {
                    "command": "topo.startContainer",
                    "when": "view === topo.projects && viewItem =~ /service/ && viewItem =~ /exited/",
                    "group": "inline@4"
                },
                {
                    "command": "topo.stopContainer",
                    "when": "view === topo.projects && viewItem =~ /service/ && viewItem =~ /running/",
                    "group": "inline@4"
                },
                {
                    "command": "topo.deleteContainer",
                    "when": "view === topo.projects && viewItem =~ /service/",
                    "group": "inline@5"
                },
                {
                    "command": "topo.configureProject",
                    "when": "view === topo.projects && viewItem =~ /Project/",
                    "group": "inline@1"
                },
                {
                    "command": "topo.deployProject",
                    "when": "view === topo.projects && viewItem =~ /Project/",
                    "group": "inline@2"
                },
                {
                    "command": "topo.stopProject",
                    "when": "view === topo.projects && viewItem =~ /Project/",
                    "group": "inline@3"
                }
            ],
            "view/title": [
                {
                    "command": "topo.selectTarget",
                    "when": "view == topo.target-manager && !topo.targetDataIssue",
                    "group": "navigation"
                },
                {
                    "command": "topo.connectViaSSH",
                    "when": "view == topo.target-manager && topo.selectedTargetState == 'selected' && topo.selectedTargetConnected",
                    "group": "navigation"
                },
                {
                    "command": "topo.refreshTargetData",
                    "when": "view == topo.target-manager && topo.selectedTargetState == 'selected'",
                    "group": "navigation"
                },
                {
                    "command": "topo.clearTargetSelection",
                    "when": "view == topo.target-manager && topo.selectedTargetState == 'selected'",
                    "group": "navigation"
                },
                {
                    "command": "topo.openSettings",
                    "when": "view == topo.target-manager",
                    "group": "navigation"
                },
                {
                    "command": "topo.refreshHost",
                    "when": "view == topo.host-manager",
                    "group": "navigation"
                },
                {
                    "command": "topo.cloneProject",
                    "when": "view == topo.projects",
                    "group": "navigation"
                },
                {
                    "command": "topo.refreshProjects",
                    "when": "view == topo.projects",
                    "group": "navigation"
                }
            ]
        },
        "configuration": [
            {
                "title": "Target Settings",
                "properties": {
                    "topo.targetSettings": {
                        "type": "object",
                        "default": {},
                        "markdownDescription": "Per-target settings. Add target names as keys, then use `deploy` to configure deploy options for that target. Example: `{ \"root@192.0.2.1\": { \"deploy\": { \"port\": 5000, \"forceRecreate\": true } } }`.",
                        "additionalProperties": {
                            "type": "object",
                            "additionalProperties": false,
                            "markdownDescription": "Settings for one target. Suggested properties: `deploy`.",
                            "properties": {
                                "deploy": {
                                    "type": "object",
                                    "default": {},
                                    "markdownDescription": "Deploy settings for this target. Example: `{ \"port\": 5000, \"forceRecreate\": true }`. Use either `forceRecreate` or `noRecreate`, not both.",
                                    "additionalProperties": false,
                                    "properties": {
                                        "port": {
                                            "type": "integer",
                                            "minimum": 1,
                                            "maximum": 65535,
                                            "markdownDescription": "Registry port to use when deploying to the target. Use `1`-`65535`, for example `5000`. Omit this setting to use the default port."
                                        },
                                        "forceRecreate": {
                                            "type": "boolean",
                                            "default": false,
                                            "markdownDescription": "Recreates containers even when their configuration and image have not changed. Do not use with `noRecreate`."
                                        },
                                        "noRecreate": {
                                            "type": "boolean",
                                            "default": false,
                                            "markdownDescription": "Keeps existing containers instead of recreating them. Do not use with `forceRecreate`."
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        ]
    },
    "scripts": {
        "vscode:uninstall": "node ./scripts/uninstall.cjs",
        "package": "npm run build && vsce package",
        "clean": "git clean -f -x ./node_modules ./dist ./resources ./coverage",
        "lint": "npm run prettier-check && npm run eslint-check && npm run tsc-check",
        "test": "vitest run --coverage",
        "build": "vite build --mode extension",
        "watch": "vite build --mode extension --watch --minify=false",
        "download": "node --no-warnings --experimental-strip-types scripts/download.ts",
        "bump-topo": "node --no-warnings --experimental-strip-types scripts/bump-topo.ts",
        "calculate-new-version": "node --no-warnings --experimental-strip-types scripts/calculate-new-version.ts",
        "prettier-check": "prettier -c .",
        "eslint-check": "eslint .",
        "tsc-check": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^4.1.10",
        "@types/lodash.debounce": "^4.0.9",
        "@types/node": "^22.20.1",
        "@types/vscode": "^1.101.0",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@vscode/vsce": "^3.6.2",
        "eslint": "^10.11.0",
        "extract-zip": "^2.0.1",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "tar": "^7.5.22",
        "typescript": "^6.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.9",
        "vitest-mock-extended": "^5.1.1",
        "vscode-uri": "^3.1.0",
        "yargs": "^18.1.0"
    },
    "dependencies": {
        "@vscode/extension-telemetry": "^1.5.2",
        "lodash.debounce": "^4.0.8",
        "ssh-config": "^5.2.1",
        "superstruct": "^2.0.2"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Arm/vscode-topo.git"
    }
}
